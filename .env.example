# ============================================================================
# PixelMesh Environment Variables Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pixelmesh?schema=public"

# Set to "true" to force in-memory mock database mode for offline testing
# USE_IN_MEMORY_DB="false"

# ----------------------------------------------------------------------------
# Distributed Cache (Redis / Upstash) - Phase 1 Milestone 2
# ----------------------------------------------------------------------------
# Native Redis connection string
REDIS_URL="redis://localhost:6379"

# Upstash Serverless REST Redis (Alternative to direct Redis TCP connection)
# UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# ----------------------------------------------------------------------------
# Server & Environment Configuration
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
